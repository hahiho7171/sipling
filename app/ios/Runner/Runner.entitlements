<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Ana uygulama ile ana-ekran widget'ı (SiplingWidget) aynı veriyi görsün diye
	  ortak App Group. `home_widget` iOS'ta veriyi bu grubun UserDefaults'ına yazar;
	  widget oradan okur. Widget uzantısının entitlements'ında da AYNI grup olmalı.
	  ⚠️ Bu grubu Apple Developer hesabında da tanımla (Identifiers → App Groups).
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sipling.app</string>
	</array>
	<!--
	  🚨 WeatherKit entitlement'ı KALDIRILDI (2026-07-31, Guideline 5.2.5 reddi).
	  Apple bu entitlement'ı görünce " Weather" markası + yasal kaynak linki +
	  fiziksel cihaz ekran videosu şart koşuyor. "Sıcak gün uyarısı" özelliği
	  kullanıcı kararıyla iOS'tan çıkarıldı; entitlement kalırsa Apple özelliği
	  hâlâ var sanıp aynı maddeden yeniden reddeder. GERİ EKLEME.
	-->
</dict>
</plist>
