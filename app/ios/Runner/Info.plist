	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Uygulamanın desteklediği 20 dil. App Store kaydında "diller" olarak görünür.
	     Android/web ile aynı liste (tools/diller.json). zh-Hans=Basit, zh-Hant=Geleneksel. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
		<string>es</string>
		<string>pt</string>
		<string>de</string>
