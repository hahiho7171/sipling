<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- İhracat uyumluluğu: Sipling özel şifreleme kullanmaz (yalnız standart HTTPS).
	     Bu satır olmadan her TestFlight yüklemesinde "Missing Compliance" sorulur. -->
